# Copy to .env and fill in. .env is gitignored.
#
# The app reads only DATABASE_URL. For AWS RDS with TLS:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full&sslrootcert=./global-bundle.pem
# Download the RDS root cert bundle into the repo root first:
#   curl -o global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

PGHOST=your-instance.rds.amazonaws.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=./global-bundle.pem

DATABASE_URL=postgresql://postgres:<PASSWORD>@your-instance.rds.amazonaws.com:5432/postgres?sslmode=verify-full&sslrootcert=./global-bundle.pem

# Local Postgres alternative (no TLS):
# DATABASE_URL=postgresql://razorcovery:devpass@localhost:5432/razorcovery

# --- Voice agent (Gemini) ---
GOOGLE_API_KEY=your-gemini-api-key

# --- Real outbound telephony (optional) ---
# Set LIVEKIT_* + SIP_OUTBOUND_TRUNK_ID and the batch runner places real
# phone calls. Leave blank and it runs headless Gemini conversations (no PSTN).
LIVEKIT_URL=                    # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=razorcovery-agent

# Register your SIP provider (Vobiz/Twilio/Plivo/Exotel) as a LiveKit
# outbound trunk once, then paste the printed id:
#   python -m voice.setup_trunk --address <sip-host> --number +91XXXXXXXXXX \
#     --user <sip-user> --password <sip-pass> [--transport auto|udp|tls]
SIP_OUTBOUND_TRUNK_ID=
SIP_CALLER_ID=                  # your DID in E.164, shown to the callee

# --- Website live demo (client-demo/ -> metrics/demo_api.py) ---
# Lets visitors on the client website talk to the real recovery agent
# from their browser mic (LiveKit WebRTC; no phone is ever dialled).
# Needs LIVEKIT_* above + GOOGLE_API_KEY and a running worker
# (python -m voice.agent start). Off unless set to true.
DEMO_ENABLED=false
# Comma-separated origins allowed to call /api/demo/* (CORS)
DEMO_ALLOWED_ORIGINS=http://localhost:3000
DEMO_MAX_CONCURRENT=2           # live demo calls at once
DEMO_RATE_LIMIT_PER_HOUR=5      # new demo calls per client IP per hour
