# Copy to .env.local and fill in. Never commit .env / .env.local.
# Everything prefixed NEXT_PUBLIC_ is embedded in the browser bundle:
# do NOT put API keys, LiveKit secrets or DB URLs here.

# Base URL of the core backend (uvicorn metrics.app:app), e.g.
# http://localhost:8000 in development. When set, the three payment-recovery
# scenarios on /demo are live calls to the real agent (the backend needs
# DEMO_ENABLED=true and this site's origin in DEMO_ALLOWED_ORIGINS). When
# empty, every scenario runs on the built-in simulator.
NEXT_PUBLIC_API_URL=

# Optional: URL that accepts the contact form as a JSON POST. When empty the
# form validates and shows a "demo mode, nothing was sent" confirmation.
NEXT_PUBLIC_CONTACT_ENDPOINT=
